# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit your real API key.

# Your Riot Games API key (regenerate at https://developer.riotgames.com every 24h for dev keys)
RIOT_API_KEY=RGAPI-your-key-here

# Your League of Legends account in Name#TAG format
SUMMONER=YourName#TAG

# Your server region: KR, NA, EUW, EUNE
REGION=NA

# How many recent ranked games to scan (only Akali games are kept)
GAME_COUNT=300
